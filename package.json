{
  "name": "dsh-instance-manager",
  "version": "0.9.4",
  "description": "DSH 实例管理面板：通过 Mini Utility Dock 列出本机 3080–3129 端口的全部 dsh web 实例（端口 / PID / 运行时长 / 会话数），支持优雅停止、两步确认停止当前实例、一键全部结束与新实例启动。Mini Utility Dock panel for DeepSeek Harness: list every local dsh web instance on ports 3080-3129 (port/PID/uptime/sessions) with graceful stop, Task-Manager-style stop of the current instance, stop-all, and one-click launch of a new instance.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "npm run dock:check && node --test test/*.test.js",
    "dock:sync": "dsh-mini-utility-dock sync lib/client.js",
    "dock:check": "dsh-mini-utility-dock check lib/client.js",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "dsh-mini-utility-dock": "0.1.1"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "instance-manager",
    "summary": "统一查看并停止本机 3080–3129 端口的 dsh web 实例：端口、PID、运行时长、会话数，优雅退出（会话落盘），含启动新实例与一键全部结束；入口位于 Mini Utility Dock。",
    "categories": ["dev", "Web UI"],
    "surfaces": ["host", "web"],
    "capabilities": {},
    "compatibility": {
      "dsh": ">=0.1.0-rc.5",
      "node": ">=20"
    },
    "permissions": {
      "network": ["http://127.0.0.1:*"]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xswt442-cmd/dsh-instance-manager.git"
  },
  "homepage": "https://github.com/xswt442-cmd/dsh-instance-manager#readme",
  "bugs": {
    "url": "https://github.com/xswt442-cmd/dsh-instance-manager/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "dsh-plugin",
    "instance-manager",
    "process-manager"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
